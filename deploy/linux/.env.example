# Copy to .env on the target machine. Never commit actual values.
APP_DOMAIN=farm.example.com
ACME_EMAIL=admin@example.com
# Generate DIFFERENT passwords with: openssl rand -hex 32
DB_OWNER_PASSWORD=
DB_PASSWORD=
# Generate with: openssl rand -base64 32
JWT_SECRET=
# For a Build-Release ZIP, set JAR_FILE=backend.jar; for a repo build use target/...
JAR_FILE=target/backend-0.0.1-SNAPSHOT.jar
RELEASE_TAG=local
