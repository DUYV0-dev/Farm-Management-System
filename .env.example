# ==============================================================================
# Farm Management System N02 - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure secrets before deploying:
#   cp .env.example .env
# IMPORTANT: Never commit .env into version control.
# ==============================================================================

# --- Application Server ---
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

# --- Database Connection (PostgreSQL) ---
# For Docker Compose deployment, host is 'postgres':
# DB_URL=jdbc:postgresql://postgres:5432/farm_management_erd_v1
# For Bare-Metal / Local standalone deployment:
DB_URL=jdbc:postgresql://localhost:5432/farm_management_erd_v1
POSTGRES_DB=farm_management_erd_v1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_Postgres_Password_2026!
POSTGRES_PORT=5432

# Runtime Application User (Least Privilege)
DB_USERNAME=farm_app
DB_PASSWORD=ChangeMe_FarmApp_Password_2026!

# --- Security & JWT Secret ---
# Must be a Base64-encoded string representing at least 32 cryptographically secure random bytes (256 bits).
# Generate on Linux/macOS:
#   openssl rand -base64 32
# Generate on PowerShell:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=b7jN8i19qLz8Wv0M3kP4sR6uX2yA5cE7gI9kO1mQ3sU=

# JWT Issuer & Audience (optional overrides, defaults provided in properties)
# AUTH_JWT_ISSUER=farm-management-n02
# AUTH_JWT_AUDIENCE=farm-management-clients

# --- Initial Seed / Bootstrap Account (Only when seeding initial users) ---
# SEED_USERNAME=admin.demo
# SEED_EMAIL=admin.demo@farm.local
# SEED_PASSWORD=SuperAdminPass2026!
